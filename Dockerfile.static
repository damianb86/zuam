FROM node:20-alpine AS build

WORKDIR /app

ARG NEXT_PUBLIC_ZUAM_API_BASE_URL=/api
ARG NEXT_PUBLIC_OPENAI_CHAT_ASSISTANT_NAME="Zuam AI Assistant"
ARG NEXT_PUBLIC_OPENAI_CHAT_MODEL_LABEL="GPT-5.4 Nano"
ARG NEXT_PUBLIC_ZUAM_CONTACT_EMAIL=contact@zuam.com
ARG NEXT_PUBLIC_CHAT_CONTACT_INITIAL_CAPTURE_DELAY_MS=12000
ARG NEXT_PUBLIC_CHAT_CONTACT_FOLLOWUP_CAPTURE_DELAY_MS=90000

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_ZUAM_API_BASE_URL=${NEXT_PUBLIC_ZUAM_API_BASE_URL}
ENV NEXT_PUBLIC_OPENAI_CHAT_ASSISTANT_NAME=${NEXT_PUBLIC_OPENAI_CHAT_ASSISTANT_NAME}
ENV NEXT_PUBLIC_OPENAI_CHAT_MODEL_LABEL=${NEXT_PUBLIC_OPENAI_CHAT_MODEL_LABEL}
ENV NEXT_PUBLIC_ZUAM_CONTACT_EMAIL=${NEXT_PUBLIC_ZUAM_CONTACT_EMAIL}
ENV NEXT_PUBLIC_CHAT_CONTACT_INITIAL_CAPTURE_DELAY_MS=${NEXT_PUBLIC_CHAT_CONTACT_INITIAL_CAPTURE_DELAY_MS}
ENV NEXT_PUBLIC_CHAT_CONTACT_FOLLOWUP_CAPTURE_DELAY_MS=${NEXT_PUBLIC_CHAT_CONTACT_FOLLOWUP_CAPTURE_DELAY_MS}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/static/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html

EXPOSE 8080
