FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY services/zuam-api ./services/zuam-api
COPY data/zuamContent.json ./data/zuamContent.json
# Sólo el index.html del bundle de La Casita: de ahí se toman las etiquetas de
# los assets (llevan hash) para las páginas de juntada.
COPY static-apps/truco/index.html ./static-apps/truco/index.html

EXPOSE 3000

CMD ["node", "services/zuam-api/server.mjs"]
