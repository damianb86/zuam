# Server-only OpenAI credentials.
# Required for /api/chat. Do not expose this value with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Server-only chat configuration.
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_CHAT_MAX_OUTPUT_TOKENS=800

# Client-visible chat UI configuration.
NEXT_PUBLIC_OPENAI_CHAT_MODEL_LABEL=GPT-5.5
NEXT_PUBLIC_OPENAI_CHAT_ASSISTANT_NAME=Zuam AI Assistant

# Contact settings used by the website and optional contact form delivery.
NEXT_PUBLIC_ZUAM_CONTACT_EMAIL=contact@zuam.com
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
