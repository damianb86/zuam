COMPOSE_PROJECT_NAME=zuam
SHARED_DOCKER_NETWORK=shared_apps

# Public hostname routed by the shared Caddy container.
APP_HOST=zuam.example.com

# Static build-time public configuration.
NEXT_PUBLIC_ZUAM_API_BASE_URL=/api
NEXT_PUBLIC_OPENAI_CHAT_ASSISTANT_NAME=Zuam AI Assistant
NEXT_PUBLIC_OPENAI_CHAT_MODEL_LABEL=GPT-5.4 Nano
NEXT_PUBLIC_ZUAM_CONTACT_EMAIL=contact@zuam.com
NEXT_PUBLIC_CHAT_CONTACT_INITIAL_CAPTURE_DELAY_MS=180000
NEXT_PUBLIC_CHAT_CONTACT_FOLLOWUP_CAPTURE_DELAY_MS=180000

# Server-only OpenAI credentials for the API container.
# Do not expose this value with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_CHAT_MAX_OUTPUT_TOKENS=800
OPENAI_CHAT_REASONING_EFFORT=low
OPENAI_CHAT_VERBOSITY=low
OPENAI_SCOPE_GUARD_ENABLED=true
OPENAI_OUTPUT_GUARD_ENABLED=true
# Optional. Defaults to OPENAI_CHAT_MODEL when empty.
OPENAI_SCOPE_GUARD_MODEL=
OPENAI_SCOPE_GUARD_REASONING_EFFORT=low
OPENAI_API_TIMEOUT_MS=45000
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_SESSION_RATE_LIMIT_PER_MINUTE=6
CHAT_SESSION_DAILY_LIMIT=30
CHAT_IP_DAILY_LIMIT=120
CHAT_MIN_SESSION_AGE_MS=1200
CHAT_MAX_MESSAGES_PER_REQUEST=18
CHAT_MAX_LATEST_MESSAGE_CHARS=2000

# Contact delivery. Resend is the default production channel. "auto" uses
# Resend when configured, then SMTP, then webhook.
CONTACT_DELIVERY_METHOD=resend
CHAT_CONTACT_EMAIL_ENABLED=true
CONTACT_EMAIL=contact@zuam.com
CONTACT_EMAIL_TO=contact@zuam.com

# Resend delivery.
RESEND_API_KEY=
RESEND_FROM=Zuam Website <noreply@zuam.dev>
RESEND_TIMEOUT_MS=15000

# Optional webhook delivery.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_WEBHOOK_TIMEOUT_MS=15000

# Optional SMTP fallback. Google SMTP works with an app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Zuam Website
EMAIL_TIMEOUT_MS=15000

# Optional CORS allow-list for non-same-origin local/staging API calls.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://preview.example.com
ALLOWED_ORIGINS=

# Low-cost abuse controls for the public API.
CHAT_RATE_LIMIT_PER_MINUTE=12
CONTACT_RATE_LIMIT_PER_MINUTE=5
MAX_BODY_BYTES=131072

# Docker log rotation defaults.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Juntadas de truco (La Casita). Sin esta variable la sección queda apagada.
# En Docker apunta al Postgres compartido del stack:
# JUNTADA_DATABASE_URL=postgresql://zuam:PASSWORD@postgres:5432/zuam?connection_limit=4
JUNTADA_DATABASE_URL=
JUNTADA_DB_POOL_MAX=4

# --- Bot de WhatsApp de las juntadas (servicio "wa", opcional) ---
# Ver services/zuam-wa/README.md. Se levanta con docker-compose.wa.yml.
WA_TRIGGERS=@truco,@bot,@juntada
WA_DISMISSALS=listo,gracias,chau,ya esta,nada mas
WA_SESSION_TTL_MINUTES=360
# Poner en 1 para que ./deploy.sh levante y mantenga el contenedor del bot.
# Con 0 (o sin definir), el bot no se toca en los deploys de Zuam.
WA_ENABLED=0
# Que grupos lee el bot NO se configura aca: se elige en la interfaz web
# (http://localhost:3210/?token=...). Arrancan todos apagados.
WA_ADMIN_TOKEN=
WA_ADMIN_PORT=3210
# Chats 1-a-1: apagados. El bot vive en grupos.
WA_ALLOW_DIRECT=false
# Modo despierto: una vez invocado, lee el grupo y opina si aporta algo.
WA_AMBIENT=true
WA_AMBIENT_MIN_MESSAGES=4
WA_AMBIENT_COOLDOWN_MINUTES=10
WA_ALLOW_SELF=true
WA_LOG_MESSAGE_TEXT=true
# Numero con pais y sin "+" para vincular por codigo en vez de QR.
WA_PAIRING_NUMBER=
# Ruido interno de Baileys: warn|info|debug.
WA_LOG_LEVEL=warn
# Descarta los mensajes viejos que WhatsApp reenvia al conectar.
WA_MAX_MESSAGE_AGE_SECONDS=120
# IA del bot. Usa OPENAI_API_KEY (la misma del chat del landing).
WA_OPENAI_MODEL=gpt-5.6-luna
WA_OPENAI_MAX_OUTPUT_TOKENS=500
WA_OPENAI_REASONING_EFFORT=low
# Origen que sirve las paginas /j/{id} que el bot comparte por link.
WA_MEETUP_BASE_URL=https://zuam.com
# Reaccionar con un pulgar en vez de escribir cuando la intencion es evidente.
WA_SILENT_REACTIONS=true
# Dias que se guardan los mensajes leidos.
WA_RETENTION_DAYS=7
